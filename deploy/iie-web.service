[Unit]
Description=IIE Kaoyan SvelteKit SSR
After=network-online.target iie-api.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/iie-cskaoyan/current/frontend
EnvironmentFile=/etc/iie-cskaoyan/web.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node /srv/iie-cskaoyan/current/frontend/build/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
