[Unit]
Description=IIE Kaoyan Axum API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/iie-cskaoyan/current/backend
EnvironmentFile=/etc/iie-cskaoyan/api.env
Environment=UPLOAD_DIR=/srv/iie-cskaoyan/uploads
ExecStart=/srv/iie-cskaoyan/current/backend/iie-cskaoyan-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/iie-cskaoyan/uploads

[Install]
WantedBy=multi-user.target
